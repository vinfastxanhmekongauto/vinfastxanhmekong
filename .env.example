# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — VINFAST MEKONG WEBSITE
# Copy to .env or .env.local and fill with production values.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO SOURCE CONTROL!
# ==============================================================================

# --- Node Environment ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Supabase Configuration (Primary Website Database & Auth) ---
# Supabase project URL and anon public key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY — bypasses RLS, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Website Public URL & SEO ---
NEXT_PUBLIC_BASE_URL=https://vinfastmekong.vn
NEXT_PUBLIC_SITE_URL=https://vinfastmekong.vn

# --- Google Analytics 4 ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Resend Email Service ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address using verified business domain vinfastmekong.vn
RESEND_FROM_EMAIL=VinFast Mekong <thongbao@vinfastmekong.vn>
# Comma-separated admin notification recipient emails
ADMIN_EMAIL=admin1@vinfastmekong.vn,admin2@gmail.com
# Customer service email
CSKH_EMAIL=cskh@vinfastmekong.vn

# --- JWT Authentication (Admin Dashboard Session) ---
JWT_SECRET=your-random-jwt-secret-min-32-chars-long

# --- BOS CRM Gateway (Secondary Background Lead Synchronization) ---
BOS_API_URL=https://gateway.vinfastmekong.vn
BOS_USERNAME=your_bos_gateway_username
BOS_PASSWORD=your_bos_gateway_password

# --- Upstash Redis (Optional Rate Limiting) ---
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# --- Google Indexing API (Service Account) ---
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --- n8n Webhook Integration (Optional) ---
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# --- Zalo OA Integration (Optional) ---
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_ACCESS_TOKEN=your_zalo_access_token
ZALO_CS_USER_ID=your_zalo_cs_user_id
